# ============================================================================
# DARKTOON AI — Environment Configuration (.env.example)
# ============================================================================

# Application & Security
NODE_ENV=development
PORT=3000
APP_SECRET=darktoon-dev-secret-change-in-production

# Database & Storage
# Local SQLite database path (default for zero-dependency execution)
DATABASE_PATH=./storage/darktoon.sqlite
# Optional PostgreSQL URL when running with Docker Compose
DATABASE_URL=postgresql://darktoon:darktoon_secret@localhost:5432/darktoon_ai
STORAGE_ROOT=./storage/objects

# Redis Queue (Optional when running distributed workers via Docker)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# AI Provider Configuration
# Important: If a real provider is selected without its API key configured,
# DARKTOON AI will report status = NOT_CONFIGURED and will NEVER fake real AI
# output. Use ALLOW_DEV_MOCK_PROVIDER=true to test with explicit [MOCK] data.
# ============================================================================

# Active Providers: "openai" | "gemini" | "replicate" | "mock"
DEFAULT_ASR_PROVIDER=openai
DEFAULT_DIARIZATION_PROVIDER=openai
DEFAULT_LLM_PROVIDER=openai
DEFAULT_IMAGE_PROVIDER=openai
DEFAULT_VIDEO_PROVIDER=gemini

# Explicit Development Mock Provider toggle (marks all outputs with [MOCK])
ALLOW_DEV_MOCK_PROVIDER=true

# OpenAI (Whisper ASR, GPT-4o Story Director, gpt-image-1 / DALL-E 3)
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3

# Google Gemini (Audio Analysis, Story Director, Imagen 3, Veo 2)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# Replicate / Kling / Runway (Optional Image-to-Video Adapter)
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v1.6-standard
